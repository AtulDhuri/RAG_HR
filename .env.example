APP_NAME=Knowledge Intelligence Engine
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://knowledge:knowledge@localhost:5432/knowledge
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=52428800
AUTO_CREATE_SCHEMA=false
DEFAULT_TENANT_ID=default
EMBEDDING_DIMENSION=384
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AUTH_TOKEN_TTL_SECONDS=28800
LLAMA_CLOUD_API_KEY=
LLAMA_PARSE_ENABLED=true
LLAMA_PARSE_FALLBACK_LOCAL=false
LLAMA_PARSE_TIER=agentic
LLAMA_PARSE_VERSION=latest
LLAMA_PARSE_OCR_LANGUAGES=["en"]
LLAMA_PARSE_REQUEST_TIMEOUT_SECONDS=300
LLAMA_PARSE_JOB_TIMEOUT_SECONDS=900
LLAMA_PARSE_MAX_WAIT_SECONDS=1800
LLAMA_PARSE_POLL_INTERVAL_SECONDS=5
LLAMA_PARSE_MAX_RETRIES=3
LLAMA_PARSE_RETRY_BACKOFF_SECONDS=3
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
